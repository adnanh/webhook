- id: signed
  execute-command: ./build/demo-hook
  http-methods: [POST]
  include-command-output-in-response: true
  trigger-rule-mismatch-http-response-code: 403
  pass-arguments-to-command:
    - source: string
      name: echo
    - source: payload
      name: ref
  trigger-rule:
    and:
      - match:
          type: payload-hmac-sha256
          secret: '{{ getenv "DEMO_HMAC_SECRET" }}'
          parameter:
            source: header
            name: X-Hub-Signature-256
      - match:
          type: value
          value: refs/heads/main
          parameter:
            source: payload
            name: ref
