# OSS 发布示例配置。
# 使用时复制为 .env.update-web，并填写真实值；不要提交真实密钥或校验码。

# 必填：OSS 基础路径，不要包含 APP 后缀。
WEB_DEV_OSS_BASE_URI='oss://your-bucket/path/to/web-root'

# 必填：公网访问基础地址。
WEB_DEV_ACCESS_BASE_URL='https://static.example.com'

# 可选：如果 ossutil 不在 PATH 中，可以改成实际二进制路径。
OSSUTIL_BIN='ossutil64'

# 可选：超级码。设置后可发布任意合法 APP 名称。
WEB_DEV_SUPER_CODE=''

# 必填：允许发布的 APP 清单，多个 APP 用空格分隔。
WEB_DEV_ALLOWED_APPS='iot2 admin-web'

# 必填：每个 APP 的校验码。
# 变量名格式为 WEB_DEV_CODE_${APP}，其中 APP 转为大写，- 转为 _。
# 例如 APP=admin-web 时，对应变量名为 WEB_DEV_CODE_ADMIN_WEB。
WEB_DEV_CODE_IOT2='CHANGE_ME_IOT2_CODE'
WEB_DEV_CODE_ADMIN_WEB='CHANGE_ME_ADMIN_WEB_CODE'
